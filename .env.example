# ==========================================
# SMASHFLOW - SEPAY & VIETQR CONFIGURATION
# ==========================================

# SePay API Key (lấy tại my.sepay.vn -> Cấu hình công ty -> API Access)
# Dùng để xác thực Webhook và gọi API đối soát giao dịch tự động
SEPAY_API_KEY=your_sepay_api_key_here

# Secret Key riêng cho Webhook (tùy chọn; nếu để trống sẽ tự động dùng SEPAY_API_KEY)
WEBHOOK_BANK_SECRET=

# Bật kiểm tra IP allowlist chính thức của SePay (false = tắt khi test/dev, true = bật trên production)
SEPAY_WEBHOOK_IP_CHECK=false

# SePay API Host URL
SEPAY_BASE_URL=https://my.sepay.vn

# Thông tin tài khoản ngân hàng nhận tiền (dùng sinh mã VietQR và đối soát)
BANK_BIN=MB
BANK_ACCOUNT=0325872682
BANK_NAME=MBBank
BANK_OWNER=PHAM ANH DUC

# Database Configuration (Docker Postgres on port 5433)
DB_URL=jdbc:postgresql://localhost:5433/smashflow_db
DB_USERNAME=postgres
DB_PASSWORD=password123

# Telegram Alert Bot (Bắn thông báo tức thời khi tiền về)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
